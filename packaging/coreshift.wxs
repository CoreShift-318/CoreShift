<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CoreShift: Chrono-Survival"
           Manufacturer="DCIT 318 Team"
           Version="0.1.0"
           UpgradeCode="890E7874-3E1D-423D-83E5-FD6E9AA66A34"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of CoreShift is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CoreShift" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="CoreShift" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="CoreShift" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="..\dist\win-x64\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="C1F13BE7-43EE-4BBE-A89F-BDC7DAB02630">
      <Shortcut Id="AppStartMenuShortcut"
                Name="CoreShift"
                Description="CoreShift: Chrono-Survival"
                Target="[INSTALLFOLDER]CoreShift.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\CoreShift" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="2F6B1E4A-7C3D-4A9B-8E21-5D0C6B7A9F12">
      <Shortcut Id="AppDesktopShortcut"
                Name="CoreShift"
                Description="CoreShift: Chrono-Survival"
                Target="[INSTALLFOLDER]CoreShift.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\CoreShift" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
